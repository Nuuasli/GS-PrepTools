# =============================================
# GS-Prep Backend Environment Variables (Example)
# =============================================
# Copy this file to .env and adjust values as needed.

# Application
GSPREP_APP_NAME=GS-Prep
GSPREP_APP_VERSION=0.1.0
GSPREP_APP_ENV=development
GSPREP_DEBUG=true

# Server
GSPREP_HOST=0.0.0.0
GSPREP_PORT=8000

# CORS
GSPREP_CORS_ORIGINS=["http://localhost:3000"]

# Storage
GSPREP_UPLOAD_DIR=storage/uploads
GSPREP_JOBS_DIR=storage/jobs
GSPREP_FFPROBE_BINARY=ffprobe
GSPREP_FFPROBE_TIMEOUT_SECONDS=120

# Processing Defaults
GSPREP_DEFAULT_EXTRACTION_FPS=2
GSPREP_DEFAULT_JPEG_QUALITY=100
GSPREP_DEFAULT_BLUR_THRESHOLD=10.0
GSPREP_DEFAULT_DUPLICATE_THRESHOLD=0.5
GSPREP_DEFAULT_RESIZE_WIDTH=0

# Limits
GSPREP_MAX_UPLOAD_SIZE_MB=2048

# Job lifecycle
GSPREP_UPLOADED_JOB_TTL_HOURS=1
GSPREP_COMPLETED_JOB_TTL_HOURS=24
GSPREP_FAILED_JOB_TTL_HOURS=6
GSPREP_CLEANUP_INTERVAL_MINUTES=15
