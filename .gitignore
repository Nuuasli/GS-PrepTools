# =============================================
# GS-Prep Monorepo .gitignore
# =============================================

# ----- Frontend (Next.js) -----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ----- Backend (Python) -----
backend/.venv/
backend/__pycache__/
backend/app/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ----- Storage (working files) -----
backend/storage/uploads/*
backend/storage/jobs/*
!backend/storage/uploads/.gitkeep
!backend/storage/jobs/.gitkeep

# ----- Environment -----
.env
.env.*
!.env.example

# ----- IDE / OS -----
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# ----- Debug -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Misc -----
*.pem
.vercel

#ignore
cara_penggunaan.txt